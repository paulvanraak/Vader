# Nooit committen met een echte waarde. De sleutel blijft server-side.
ANTHROPIC_API_KEY=

# Optioneel: standaard claude-sonnet-5. Bevestig de actuele modelnaam op docs.claude.com.
CLAUDE_MODEL=claude-sonnet-5

# Supabase project dat de CMS-content (werelden, lessen, specialisten) bevat.
# De publishable key is bedoeld om client-side te gebruiken (read + write via
# RLS-policies, geen geheime sleutel).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
