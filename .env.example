# Nooit committen met een echte waarde. De sleutel blijft server-side.
ANTHROPIC_API_KEY=

# Optioneel: standaard claude-sonnet-5. Bevestig de actuele modelnaam op docs.claude.com.
CLAUDE_MODEL=claude-sonnet-5

# Supabase project dat de CMS-content (werelden, lessen, specialisten) bevat.
# De publishable key is bedoeld om client-side te gebruiken (read + write via
# RLS-policies, geen geheime sleutel).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev-paneel. Alleen in de preview-omgeving op 'true' zetten, nooit in
# productie: het prebuild-script laat de build dan expres falen.
VITE_DEV_TOOLS=false

# Vaste testgebruiker voor de snelle route in het dev-paneel. Dit is een echt
# account, zodat RLS van kracht blijft. Nooit met een waarde committen.
VITE_DEV_TEST_EMAIL=
VITE_DEV_TEST_PASSWORD=
